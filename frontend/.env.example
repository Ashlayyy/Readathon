# Public API base (no trailing slash). Leave empty in dev (Vite proxies /api).
# Production example: https://api.your-domain.com
VITE_API_URL=

# --- PostHog (optional) ---
# Project API key from PostHog → Project settings. Leave blank to disable.
# VITE_POSTHOG_KEY=phc_xxxxxxxx
# EU cloud (default in code if unset): https://eu.i.posthog.com
# US cloud: https://us.i.posthog.com
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
