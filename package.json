{
  "name": "readathon",
  "private": true,
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix frontend\"",
    "build": "npm run build --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend -- --host 0.0.0.0",
    "dev:server": "npm run dev --prefix server",
    "start:server": "npm run start --prefix server",
    "preview:frontend": "npm run preview --prefix frontend -- --host 0.0.0.0 --port 5173",
    "pm2:start": "npm run build --prefix frontend && mkdir -p logs && APP_MODE=production pm2 start ecosystem.config.cjs",
    "pm2:start:dev": "mkdir -p logs && APP_MODE=development pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "test": "npm run test --prefix server",
    "test:security": "npm run test:security --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
