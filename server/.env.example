# Server environment — copy to server/.env

PORT=3001
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string

# MongoDB connection
MONGODB_URI=mongodb://127.0.0.1:27017/realmathon

# Comma-separated admin emails (checked on every admin request)
ADMIN_EMAILS=your@email.com

# Magic-link email (optional — without this, links print to the server console in dev)
RESEND_API_KEY=
EMAIL_FROM=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
