# MongoDB Atlas connection - replace with your cluster URI
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/readathon?retryWrites=true&w=majority

PORT=3001
# Player SPA origin (Book Baddies / /e/:slug) — local: http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Optional alias used when building share links for players
# PLAYER_URL=http://localhost:5173
# Product.com marketing + host panel — local: http://localhost:5174
PRODUCT_URL=http://localhost:5174
# Public API origin when hosted on a separate subdomain (no trailing slash)
API_URL=https://api.your-domain.com
SESSION_SECRET=change-me-to-a-long-random-string
# Share session cookies across product.com + *.product.com (production).
# Omit locally. Example: .product.com
# COOKIE_DOMAIN=.product.com
# Extra browser origins allowed for credentialed CORS (comma-separated).
# Subdomains of PRODUCT_APEX are allowed automatically.
# CORS_ORIGINS=https://staging.product.com

# Encrypts Discord bot token (and other secrets) stored in Mongo via Admin.
# Prefer a dedicated key; if unset, SESSION_SECRET is hashed as the key.
SETTINGS_ENCRYPTION_KEY=change-me-to-another-long-random-string

# Optional migration fallbacks (prefer Admin → Settings → Discord bot):
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=

# Comma-separated admin emails (checked on every admin request)
ADMIN_EMAILS=your@email.com

# Magic-link email (required for email login in production)
RESEND_API_KEY=
EMAIL_FROM=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.your-domain.com/auth/google/callback

# --- Prometheus (optional) ---
# METRICS_TOKEN=long-random-token

# --- PostHog (optional, server-side events) ---
# Personal/project API key with write access. Leave blank to disable.
# POSTHOG_API_KEY=phx_xxxxxxxx
# POSTHOG_HOST=https://eu.i.posthog.com

# --- Better Stack (optional) ---
# Logs: create a HTTP source → copy Source token (+ ingesting host if shown)
# BETTERSTACK_SOURCE_TOKEN=
# BETTERSTACK_INGESTING_HOST=in.logs.betterstack.com
# Or full endpoint override:
# BETTERSTACK_ENDPOINT=https://in.logs.betterstack.com
#
# Uptime heartbeat: create a Heartbeat monitor → paste the ping URL
# BETTERSTACK_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/xxxxx
#
# Also create an HTTP uptime monitor pointing at:
#   https://api.your-domain.com/api/health

# --- Multi-tenant product ---
# Working product apex for new hosts / marketing (not player URLs yet).
PRODUCT_APEX=product.com
PRODUCT_NAME=Product
# Comma-separated hosts that always resolve to the default Book Baddies tenant:
LEGACY_PLAYER_HOSTS=bookbaddies.net,www.bookbaddies.net
# Shared Discord bot for all tenants (hosts invite it). Optional per-tenant Admin override still works.
PLATFORM_DISCORD_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
#
# Automatic DB backfill on boot (no manual Mongo work):
#   auto  = run only when pending work is detected (default)
#   force = always re-run stamp/link/index sync
#   off   = skip (only ensure default tenant); use CLI/Admin to migrate later
# TENANCY_MIGRATE=auto
# CLI: cd server && npm run migrate:tenancy
#      cd server && npm run migrate:tenancy -- --force
