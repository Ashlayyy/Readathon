# MongoDB Atlas connection — replace with your cluster URI
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/readathon?retryWrites=true&w=majority

PORT=3001
# Public URL users visit in the browser (the frontend)
FRONTEND_URL=https://your-domain.com
# Public API origin when hosted on a separate subdomain (no trailing slash)
API_URL=https://api.your-domain.com
SESSION_SECRET=change-me-to-a-long-random-string

# Comma-separated admin emails (checked on every admin request)
ADMIN_EMAILS=your@email.com

# Magic-link email (required for email login in production)
RESEND_API_KEY=
EMAIL_FROM=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.your-domain.com/auth/google/callback
