{
	"name": "server",
	"version": "1.6.0",
	"type": "module",
	"engines": {
		"node": "^22.18.0 || >=24.12.0"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "NODE_ENV=production tsx src/index.ts",
		"test": "node --import tsx --test \"src/**/*.test.ts\"",
		"test:coverage": "c8 --all --include=src/**/*.ts --exclude=src/**/*.test.ts --exclude=src/types/** --exclude=src/security.integration.manual.ts --reporter=text-summary --reporter=text --reporter=html --check-coverage --lines 0 --functions 0 --branches 0 --statements 0 node --import tsx --test \"src/**/*.test.ts\"",
		"test:security": "node --import tsx --test src/security.integration.manual.ts"
	},
	"dependencies": {
		"@fontsource/dejavu-sans": "^5.2.5",
		"@hono/node-server": "^2.0.12",
		"@logtail/node": "^0.5.8",
		"@resvg/resvg-js": "^2.6.2",
		"arctic": "^3.7.0",
		"dotenv": "^17.4.2",
		"fontkit": "^2.0.4",
		"hono": "^4.12.32",
		"jose": "^6.2.3",
		"mongoose": "^9.8.0",
		"posthog-node": "^5.45.2",
		"prom-client": "^15.1.3"
	},
	"devDependencies": {
		"@types/node": "^26.0.0",
		"c8": "^12.0.0",
		"mongodb-memory-server": "^11.2.0",
		"tsx": "^4.22.4",
		"typescript": "~7.0.2"
	}
}
